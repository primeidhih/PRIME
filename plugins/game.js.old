const { cmd } = require("../lib");
const { AIRich, Toolkit, richSupported } = require("../lib/airich");

const SOURCE_URL = 'https://nixel.dev';
const TRUSTED_SOURCES = ['nixel.dev'];

const DINO_HTML = `<style>*{-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}</style><body style="margin:0;background:transparent;font-family:Arial,sans-serif;color:#eee;touch-action:manipulation;cursor:pointer"><div style="width:100%;max-width:620px;margin:auto;padding:16px;box-sizing:border-box"><div style="background:rgba(255,255,255,.06);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,.15);border-radius:16px;overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,.35)"><div style="padding:18px 20px;border-bottom:1px solid rgba(255,255,255,.12);display:flex;justify-content:space-between;align-items:center"><div><div style="font-size:11px;letter-spacing:1.5px;color:rgba(255,255,255,.45)">LOFT DINO</div><div style="font-size:21px;font-weight:bold;color:#fff">Dino Runner</div></div><div style="text-align:right"><div id="score" style="font-size:18px;font-weight:bold;color:#fff;text-shadow:0 0 10px rgba(108,92,231,.85);transition:transform .15s">00000</div><div id="best" style="font-size:10px;color:rgba(255,255,255,.4);margin-top:2px">BEST 00000</div></div></div><div style="padding:18px"><canvas id="game" width="560" height="190" style="width:100%;height:auto;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.12);border-radius:12px;display:block"></canvas><div id="status" style="text-align:center;margin-top:10px;font-size:12px;color:rgba(255,255,255,.55)">Speed 5.0x</div></div></div></div><script>const c=document.getElementById('game'),x=c.getContext('2d'),scoreEl=document.getElementById('score'),bestEl=document.getElementById('best'),statusEl=document.getElementById('status');const GY=170;let d,o,clouds,particles,ambient,trail,score,best=0,speed,gameOver,last,shake,flash,runT,spawnTimer,milestone,squash;function loadBest(){let vals=[];try{let v=localStorage.getItem('dino_best');if(v)vals.push(parseInt(v,10))}catch(e){}return vals.length?Math.max(...vals.filter(v=>!isNaN(v))):0}function saveBest(v){let val=String(Math.floor(v));try{localStorage.setItem('dino_best',val)}catch(e){}}best=loadBest();function reset(){d={x:55,y:132,w:27,h:30,vy:0,jumping:false};o=[];clouds=[{x:120,y:32,w:44,s:.35},{x:300,y:52,w:60,s:.22},{x:460,y:26,w:36,s:.4},{x:560,y:70,w:50,s:.18}];particles=[];trail=[];if(!ambient){ambient=[];for(let i=0;i<18;i++)ambient.push({x:Math.random()*c.width,y:Math.random()*c.height,r:.5+Math.random()*1.5,vx:.1+Math.random()*.3,ph:Math.random()*10})}score=0;speed=5;gameOver=false;last=0;shake=0;flash=0;runT=0;milestone=0;squash=1;spawnTimer=70+Math.random()*30;bestEl.textContent='BEST '+String(Math.floor(best)).padStart(5,'0')}function burst(px,py,n,col,spd){for(let i=0;i<n;i++)particles.push({x:px,y:py,vx:(Math.random()-.5)*spd,vy:-Math.random()*spd,life:1,col,size:2+Math.random()*2})}function jumpDino(){if(gameOver){reset();return}if(!d.jumping){d.jumping=true;d.vy=-13;squash=.7;burst(d.x+13,d.y+30,10,'255,255,255',4)}}function cactus(){let h=24+Math.random()*24;o.push({x:c.width+20,y:GY-h,w:16+Math.random()*6,h})}function hit(a,b){return a.x+4<b.x+b.w&&a.x+a.w-4>b.x&&a.y+4<b.y+b.h&&a.y+a.h>b.y}function loop(t){if(!last)last=t;let dt=Math.min((t-last)/16.67,2);last=t;runT+=dt;if(!gameOver){d.y+=d.vy*dt;d.vy+=.75*dt;if(d.y>=132){if(d.jumping){burst(d.x+13,GY,10,'255,255,255',3.5);squash=1.35}d.y=132;d.vy=0;d.jumping=false}if(d.jumping)trail.push({x:d.x,y:d.y});if(trail.length>6)trail.shift();if(!d.jumping)trail.length=0;squash+=(1-squash)*.18*dt;spawnTimer-=dt;if(spawnTimer<=0){cactus();spawnTimer=Math.max(38,62-speed*1.4)+Math.random()*30}o.forEach(q=>q.x-=speed*dt);o=o.filter(q=>q.x>-40);speed=Math.min(11,speed+.0018*dt);score+=dt*.6;if(score>best)best=score;scoreEl.textContent=String(Math.floor(score)).padStart(5,'0');for(const q of o)if(hit(d,q)){gameOver=true;shake=14;flash=1;saveBest(best);burst(d.x+13,d.y+15,18,'255,90,90',5)}}draw();requestAnimationFrame(loop)}document.addEventListener('pointerdown',e=>{e.preventDefault();jumpDino()});reset();requestAnimationFrame(loop);</script></body>`;
const TICTACTOE_HTML = `<style>body{margin:0;background:transparent;color:#e9edef;font-family:Arial;display:flex;justify-content:center;align-items:center;height:100vh}.board{display:grid;grid-template-columns:repeat(3,80px);gap:5px;background:#2a3942;padding:5px;border-radius:10px}.cell{width:80px;height:80px;background:#111b21;font-size:40px;display:flex;justify-content:center;align-items:center;cursor:pointer;border-radius:5px;color:#00a884}</style><body><div class="board" id="b"></div><script>let b=Array(9).fill(null),turn='X';const board=document.getElementById('b');function draw(){board.innerHTML=b.map((v,i)=>'<div class="cell" onclick="play('+i+')">'+(v||'')+'</div>').join('')}function play(i){if(b[i]||turn!=='X')return;b[i]='X';draw();if(check('X'))return;setTimeout(ai,300)}function ai(){let e=b.map((v,i)=>v?null:i).filter(v=>v!==null);if(!e.length)return;let m=e[Math.floor(Math.random()*e.length)];b[m]='O';draw();check('O')}function check(p){const w=[[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];for(let i of w){if(b[i[0]]===p&&b[i[1]]===p&&b[i[2]]===p){setTimeout(()=>alert(p+' wins!'),100);return true}}if(!b.includes(null)){setTimeout(()=>alert('Draw!'),100);return true}return false}draw();</script></body>`;
const SNAKE_HTML = `<style>body{margin:0;background:transparent;display:flex;justify-content:center;align-items:center;height:100vh}canvas{background:#111b21;border-radius:10px}</style><body><canvas id="g" width="300" height="300"></canvas><script>const c=document.getElementById('g'),x=c.getContext('2d');let s=[{x:10,y:10}],d={x:1,y:0},f={x:15,y:15},sc=0;function loop(){x.fillStyle='#111b21';x.fillRect(0,0,300,300);x.fillStyle='#ff4757';x.fillRect(f.x*15,f.y*15,15,15);x.fillStyle='#00a884';s.forEach(p=>x.fillRect(p.x*15,p.y*15,15,15));let h={x:s[0].x+d.x,y:s[0].y+d.y};if(h.x===f.x&&h.y===f.y){sc++;s.unshift(h);f={x:Math.floor(Math.random()*20),y:Math.floor(Math.random()*20)}}else{s.unshift(h);s.pop()}setTimeout(loop,150)}loop();document.addEventListener('keydown',e=>{if(e.key==='ArrowUp'&&d.y!==1)d={x:0,y:-1};if(e.key==='ArrowDown'&&d.y!==-1)d={x:0,y:1};if(e.key==='ArrowLeft'&&d.x!==1)d={x:-1,y:0};if(e.key==='ArrowRight'&&d.x!==-1)d={x:1,y:0}});</script></body>`;

const GAMES = {
    dino: { tab: "Dino Runner", name: "Dino Runner", html: DINO_HTML },
    ttt: { tab: "Tic Tac Toe", name: "Tic Tac Toe vs AI", html: TICTACTOE_HTML },
    snake: { tab: "Snake", name: "Snake", html: SNAKE_HTML }
};

const PACKS = { classic: { title: "Classic", games: ["dino", "snake", "ttt"] } };
PACKS.all = { title: 'All games', games: ["dino", "snake", "ttt"] };
const ALIASES = { '': 'classic', main: 'classic', classics: 'classic', default: 'classic', home: 'classic', everything: 'all', full: 'all', max: 'all' };

function buildEmbeddedScreens(ids) {
    return [{
        title: 'Preview',
        content: [{
            __typename: 'FOAIDNixelButtonSheets',
            tabs: ids.map((id, i) => ({
                id: 'tab_' + i,
                tab_header: GAMES[id].tab,
                sections: [{
                    __typename: 'GenAIUnifiedResponseSection',
                    view_model: {
                        __typename: 'GenAISingleLayoutViewModel',
                        primitive: {
                            __typename: 'GenAIaeacdsnwHtmlPrimitive',
                            payload: GAMES[id].html,
                            url: SOURCE_URL,
                            trusted_sources: TRUSTED_SOURCES
                        }
                    }
                }],
                step_entries: []
            }))
        }]
    }];
}

function attachScreens(msg, ids) {
    const unified = msg?.message?.botForwardedMessage?.message?.richResponseMessage?.unifiedResponse;
    if (!unified || !unified.data) throw new Error('arcade: rich response has no unified data');
    const raw = typeof unified.data === 'string' ? Buffer.from(unified.data, 'base64') : Buffer.from(unified.data);
    const json = JSON.parse(raw.toString('utf8'));
    json.embedded_screens = buildEmbeddedScreens(ids);
    
    // CRITICAL FIX: Must convert back to Base64
    unified.data = Buffer.from(Toolkit.stringifyEscaped(json)).toString('base64');
    return msg;
}

async function sendArcade(sock, from, key, prefix, quoted) {
    const pack = PACKS[key];
    const names = pack.games.map((id) => GAMES[id].name).join(' • ');
    const others = ['classic', 'all'].filter((k) => k !== key);

    // Using the exact AIRich builder from Loft
    const rich = new AIRich(sock).addText(
        '> 🎮 *PRIME Arcade - ' + pack.title + '* (' + pack.games.length + ' games) - tap a tab to switch\n' +
        '> ' + names + '\n' +
        '> More: ' + others.map((k) => prefix + 'arcade' + (k === 'classic' ? '' : ' ' + k)).join('  •  ')
    );

    if (typeof rich.addSuggest === 'function') {
        rich.addSuggest(others.map((k) => prefix + 'arcade' + (k === 'classic' ? '' : ' ' + k)));
    }

    const msg = attachScreens(await rich.build(from, { quoted }), pack.games);

    await sock.relayMessage(from, msg.message, { 
        messageId: msg.key.id,
        additionalNodes: [
            { tag: 'biz', attrs: {}, content: [{ tag: 'interactive', attrs: { type: 'native_flow', v: '1' }, content: [{ tag: 'native_flow', attrs: { v: '9', name: 'mixed' } }] }] }
        ]
    });
    await rich.sendEdit(from, msg.key.id, { msg: msg.message });
    return msg;
}

// ============================================
// .arcade COMMAND
// ============================================
cmd({ pattern: "arcade", aliases: ["minigames", "gamehub", "games"], react: "🎮", category: "games" },
async (from, sock, conText) => {
    const { q, mek, reply, botPrefix } = conText;
    const prefix = botPrefix || '.';
    const arg = String(q || '').trim().toLowerCase().split(/\s+/)[0];

    const has = (o, k) => Object.prototype.hasOwnProperty.call(o, k);
    const key = has(PACKS, arg) ? arg : (has(ALIASES, arg) ? ALIASES[arg] : "classic");

    try {
        await sendArcade(sock, from, key, prefix, mek);
    } catch (error) {
        console.error('[ARCADE] Error:', error?.stack || error);
        await reply('❌ Could not open the arcade.');
    }
});

// ============================================
// INDIVIDUAL GAME COMMANDS (so .snake works)
// ============================================
async function sendSingleGame(sock, from, gameId, prefix, quoted) {
    const game = GAMES[gameId];
    if (!game) return;
    
    const rich = new AIRich(sock).addText(
        '> 🎮 *PRIME Arcade - ' + game.name + '*'
    );
    
    const msg = attachScreens(await rich.build(from, { quoted }), [gameId]);
    await sock.relayMessage(from, msg.message, { 
        messageId: msg.key.id,
        additionalNodes: [{ tag: 'biz', attrs: {}, content: [{ tag: 'interactive', attrs: { type: 'native_flow', v: '1' }, content: [{ tag: 'native_flow', attrs: { v: '9', name: 'mixed' } }] }] }]
    });
    await rich.sendEdit(from, msg.key.id, { msg: msg.message });
}

cmd({ pattern: "snake", react: "🐍", category: "games" }, 
async (from, sock, conText) => { await sendSingleGame(sock, from, "snake", ".", conText.mek); });

cmd({ pattern: "dino", react: "🦖", category: "games" }, 
async (from, sock, conText) => { await sendSingleGame(sock, from, "dino", ".", conText.mek); });

cmd({ pattern: "ttt", aliases: ["tictactoe"], react: "⭕", category: "games" }, 
async (from, sock, conText) => { await sendSingleGame(sock, from, "ttt", ".", conText.mek); });
